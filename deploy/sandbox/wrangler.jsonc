{
 "$schema": "node_modules/wrangler/config-schema.json",
 "name": "appf2-sp35-private-sandbox",
 "main": "./worker.ts",
 "compatibility_date": "2026-10-29",
 "compatibility_flags": ["nodejs_compat"],
 "workers_dev": false,
 "containers": [{
  "class_name": "SandboxJob",
  "scheduling_policy": "durable_object",
  "images": {"workspace": {"dockerfile": "./Dockerfile"}}
 }],
 "workflows": [{
  "name": "appf2-sp35-private-candidate",
  "binding": "APPF2_WORKFLOW",
  "class_name": "CandidateAgentWorkflow"
 }],
 "durable_objects": {
  "bindings": [{"name": "APPF2_CONTAINER", "class_name": "SandboxJob"}]
 },
 "exports": {
  "SandboxJob": {"type": "durable-object", "storage": "sqlite"}
 }
}
