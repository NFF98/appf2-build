{
  "name": "appf2-build",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "gate": "node harness/scripts/validate-projection-map.mjs && node harness/scripts/validate-baseline.mjs && node harness/scripts/governance-gate.mjs && node harness/scripts/validate-activation.mjs && node harness/scripts/validate-skills.mjs && node harness/scripts/validate-toolchain.mjs && node harness/scripts/validate-backlog.mjs && node harness/scripts/validate-sprint.mjs && node harness/scripts/validate-findings.mjs && node harness/scripts/validate-evidence.mjs && node harness/scripts/validate-test-integrity.mjs && node harness/scripts/validate-engineering-quality.mjs && node harness/scripts/validate-release.mjs && node harness/scripts/validate-change-scope.mjs",
    "gate:baseline": "node harness/scripts/validate-baseline.mjs",
    "gate:governance": "node harness/scripts/governance-gate.mjs",
    "gate:activation": "node harness/scripts/validate-activation.mjs",
    "gate:skills": "node harness/scripts/validate-skills.mjs",
    "gate:toolchain": "node harness/scripts/validate-toolchain.mjs",
    "gate:backlog": "node harness/scripts/validate-backlog.mjs",
    "gate:sprint": "node harness/scripts/validate-sprint.mjs",
    "gate:findings": "node harness/scripts/validate-findings.mjs",
    "gate:evidence": "node harness/scripts/validate-evidence.mjs",
    "gate:release": "node harness/scripts/validate-release.mjs",
    "gate:scope": "node harness/scripts/validate-change-scope.mjs",
    "check:types": "tsc --project tsconfig.json --noEmit",
    "check:lint": "eslint .",
    "test:unit": "vitest run tests/unit",
    "test:contract": "vitest run tests/contract",
    "test:behavior": "vitest run tests/behavior",
    "test:api": "vitest run tests/api",
    "test:runtime": "vitest run tests/runtime",
    "test:state-machine": "vitest run tests/state-machine",
    "test:regression": "vitest run tests/regression",
    "test:e2e": "playwright test tests/e2e",
    "test:a11y": "playwright test tests/accessibility",
    "test:responsive": "playwright test tests/responsive",
    "test:visual": "playwright test tests/visual",
    "security:audit": "npm audit --audit-level=high",
    "product:ci": "node ci/run-product-ci.mjs",
    "product:release-ci": "node ci/run-release-ci.mjs",
    "dry-run:attack": "node harness/attack/run-dry-run.mjs",
    "release:validate": "node harness/scripts/validate-release.mjs",
    "deploy": "node deploy/scripts/deploy.mjs",
    "deploy:smoke": "node deploy/scripts/smoke.mjs",
    "deploy:rollback": "node deploy/scripts/rollback.mjs",
    "gate:projection": "node harness/scripts/validate-projection-map.mjs",
    "project:build-spec": "node harness/scripts/project-build-spec.mjs",
    "gate:test-integrity": "node harness/scripts/validate-test-integrity.mjs",
    "gate:engineering-quality": "node harness/scripts/validate-engineering-quality.mjs",
    "build": "tsc --project tsconfig.build.json",
    "web:build": "vite --config tooling/web/vite.config.ts build",
    "web:preview": "vite --config tooling/web/vite.config.ts preview",
    "web:test-server": "npm run web:build && npm run web:preview"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "eslint": "10.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "vite": "8.3.1"
  },
  "engines": {
    "node": ">=22.13 <23"
  },
  "dependencies": {
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
