+      // Proposed append-only closure guard: a pre-existing, approved round may
+      // change only IN_PROGRESS -> CLOSED; all earlier records stay byte-stable.
+      const before=oldItem.revalidation_rounds,after=newItem.revalidation_rounds;
+      if(stable(before)===stable(after)){
+        restored.push(newItem);
+        continue;
+      }
+      if(!Array.isArray(before)||!Array.isArray(after)||before.length!==after.length) return false;
+      if(oldItem.status!=="DONE"||newItem.status!=="DONE") return false;
+      const diffs=before.map((r,j)=>stable(r)===stable(after[j])?null:j).filter(j=>j!==null);
+      if(diffs.length!==1)return false;
+      const j=diffs[0];
+      if(!exactItemRevalidationClosure(before[j],after[j],ctx))return false;
+      // BLOCKED: external CI attestation authority is not integrated yet;
+      // do not permit closed-round changes by merely writing PASS in JSON.
+      return false;
     }
     if(!exactItemRevalidationClosure(oldR,newR,ctx)) return false;
     restored.push({...newItem,revalidation:oldR});
     closures++;
